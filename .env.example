# Music Together environment variables
#
# Docker Compose:
#   Copy this file to .env in the project root, edit values, then build and run:
#   docker compose up -d --build

# Host port exposed by docker-compose.yml.
BIND_ADDRESS=0.0.0.0
HOST_PORT=3001

# Optional CORS allow-list. Empty means auto mode.
CLIENT_URL=
CORS_ORIGINS=

# Number of trusted reverse-proxy hops. Keep 0 for direct access. When using 1 behind local Nginx/1Panel,
# set BIND_ADDRESS=127.0.0.1 or block direct access to HOST_PORT.
TRUST_PROXY_HOPS=0

# Revocable application sessions.
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true

# Generate with: openssl rand -base64 32
# Required in production. Keep this key backed up while encrypted room passwords exist.
ROOM_PASSWORD_KEY=
ROOM_PASSWORD_KEY_VERSION=1
ROOM_ADMISSION_TTL_MS=300000

# Generate separately with: openssl rand -base64 32
PLATFORM_AUTH_KEY=

# Used only to sign internal stream-proxy requests.
STREAM_PROXY_SECRET=

# SQLite database path. In Docker keep it under /app/data.
DATABASE_URL=file:/app/data/music-together.db

# Auto fallback between supported platforms.
AUTO_FALLBACK_ENABLED=true

# UNM HTTP proxy URL. For same Docker network, use the service/container name.
# Example: UNM_SERVER_URL=http://unm-server:80
UNM_SERVER_URL=
UNM_SERVER_TIMEOUT_MS=10000

# Server-hosted custom media. Defaults match the Docker Compose configuration.
MEDIA_ROOT=/app/data/media
MEDIA_MAX_UPLOAD_BYTES=209715200
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_MAX_ROOM_BYTES=2147483648
MEDIA_MAX_TOTAL_BYTES=10737418240
MEDIA_INACTIVITY_MS=604800000
MEDIA_CLEANUP_INTERVAL_MS=900000
MEDIA_JOB_TIMEOUT_MS=600000
# Use latest for the newest PyPI release, or pin an exact version for reproducible builds.
YTDLP_VERSION=latest
YTDLP_PATH=yt-dlp
# Optional startup upgrade for the image-provided executable. Keep false for reproducible deployments.
YTDLP_AUTO_UPDATE=false
# Optional exact version used by startup auto-update; empty means latest.
YTDLP_UPDATE_VERSION=
# Global fallback cookies for newly created and existing rooms without a room override.
# Use a browser Cookie header string (recommended for environment variables) or Netscape cookie-file content.
YOUTUBE_COOKIE=
BILIBILI_COOKIE=
FFMPEG_PATH=ffmpeg
