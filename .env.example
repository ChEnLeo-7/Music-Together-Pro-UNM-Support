# Music Together environment variables
#
# Docker Compose:
#   Copy this file to .env in the project root, edit values, then run:
#   docker compose up -d --build

# Host port exposed by docker-compose.yml.
HOST_PORT=3001

# Server runtime.
PORT=3001
NODE_ENV=production

# Optional CORS allow-list. Empty means auto mode.
CLIENT_URL=
CORS_ORIGINS=

# Number of trusted reverse-proxy hops. Keep 0 for direct access; commonly 1 behind local Nginx/1Panel.
TRUST_PROXY_HOPS=0

# Revocable application sessions.
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true

# Generate with: openssl rand -base64 32
# Required in production. Keep this key backed up while encrypted room passwords exist.
ROOM_PASSWORD_KEY=
ROOM_PASSWORD_KEY_VERSION=1
ROOM_ADMISSION_TTL_MS=300000

# Generate separately with: openssl rand -base64 32
PLATFORM_AUTH_KEY=

# Used only to sign internal stream-proxy requests.
STREAM_PROXY_SECRET=

# SQLite database path. In Docker keep it under /app/data.
DATABASE_URL=file:/app/data/music-together.db

# Auto fallback between supported platforms.
AUTO_FALLBACK_ENABLED=true

# UNM HTTP proxy URL. For same Docker network, use the service/container name.
# Example: UNM_SERVER_URL=http://unm-server:80
UNM_SERVER_URL=
UNM_SERVER_TIMEOUT_MS=10000
